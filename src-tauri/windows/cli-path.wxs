<?xml version="1.0" encoding="utf-8"?>
<!-- MSI: add the install folder to the system PATH so `marmara` works in any terminal; removed on uninstall. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MarmaraCliPath" Guid="6C1B5D2E-8F47-4C1A-9B3E-2D7A5F0E4C91">
        <Environment Id="MarmaraCliPathEnv" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\Marmara PDF\CommandLine" Name="OnPath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
