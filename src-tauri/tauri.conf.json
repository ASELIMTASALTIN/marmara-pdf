{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marmara PDF",
  "version": "0.2.1",
  "identifier": "com.marmara.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:cli -- --with-node",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marmara PDF",
        "width": 1360,
        "height": 880,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Marmara PDF",
    "shortDescription": "Free, local PDF reader and editor",
    "longDescription": "Marmara PDF is a free, open-source PDF reader and editor. All document processing happens locally on your computer.",
    "license": "AGPL-3.0-or-later",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "%1"
        ]
      },
      "digestAlgorithm": "sha256",
      "wix": {
        "fragmentPaths": [
          "windows/cli-path.wxs"
        ],
        "componentRefs": [
          "MarmaraCliPath"
        ]
      }
    },
    "resources": {
      "../dist-cli/": "cli/",
      "../ai-engine/": "ai/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBM0YzQkVBNzcxMEVDMDgKUldRSTdCQjM2anMvYW1CRnhNNTRTYzJNYzhRNXROWitUUjJhTXhKSmRZdTRkaDNYMEtqbjlGWXkK",
      "endpoints": [
        "https://github.com/ASELIMTASALTIN/marmara-pdf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
